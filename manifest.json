{
  "manifest_version": 3,
  "name": "Plato Enhanced",
  "description": "NESPA 과제 일정과 제출 상태를 PLATO 달력에 연동합니다.",
  "version": "1.6.18",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://plato.pusan.ac.kr/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://plato.pusan.ac.kr/*"
      ],
      "css": [
        "styles/calendar.css",
        "styles/class-schedule.css"
      ],
      "js": [
        "src/config.js",
        "src/nespa-settings.js",
        "src/plato-parser.js",
        "src/submission-parser.js",
        "src/storage.js",
        "src/data-source.js",
        "src/nespa-parser.js",
        "src/nespa-data-source.js",
        "src/combined-data-source.js",
        "src/calendar-model.js",
        "src/activity-modal.js",
        "src/calendar-view.js",
        "src/content.js",
        "src/class-schedule-model.js",
        "src/class-schedule.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://plato.pusan.ac.kr/course/view.php*"
      ],
      "js": [
        "weekly/quiz-status.js",
        "weekly/content.js"
      ],
      "css": [
        "weekly/style.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "host_permissions": [
    "https://onestop.pusan.ac.kr/*",
    "https://emerald.pusan.ac.kr/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": { "default_title": "Plato Enhanced 설정" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
